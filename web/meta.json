{
  "title": "Credit Risk Scoring",
  "subtitle": "Scores a loan application by the probability that the borrower turns out to be a bad credit risk, with a decision threshold tuned for the real cost of a bad loan.",
  "tags": [
    "Classification",
    "scikit-learn",
    "Random Forest",
    "Cost-sensitive threshold",
    "Nested CV",
    "ONNX"
  ],
  "task": "classification",
  "classes": [
    0,
    1
  ],
  "positive_class": 1,
  "output_label": "Probability of bad credit risk",
  "verdicts": [
    "Approve \u2014 low risk",
    "Review \u2014 above the cost-based cut-off",
    "Likely reject \u2014 high risk"
  ],
  "thresholds": [
    0.24,
    0.5
  ],
  "result_note": "A bad loan is assumed to cost 5\u00d7 more than turning away a good customer, so applications are flagged from 24% risk, not 50%. Educational demo on 1970s German data \u2014 not a real lending decision.",
  "features": [
